---
import {
  headline,
  previewDescription,
  previewTitle,
  searchDescription,
  tabTitle,
} from "../pitch";
import Site from "./Site.astro";
import VisitCounter from "../components/VisitCounter.astro";
import TopBar from "../components/TopBar.astro";
---

<Site title={tabTitle}>
  <Fragment slot="head">
    <link rel="alternate" type="text/markdown" href="/llms.txt" />
    <meta name="description" content={searchDescription} />
    <meta property="og:site_name" content="Martin" />
    <meta property="og:title" content={previewTitle} />
    <meta property="og:description" content={previewDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL("/", Astro.site).toString()} />
    <meta
      property="og:image"
      content={new URL("/og.png", Astro.site).toString()}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={headline} />
    <meta name="twitter:card" content="summary_large_image" />
    <VisitCounter />
  </Fragment>
  <slot />
  <TopBar slot="after-footer" />
</Site>
