---
import Moon from "../assets/moon.svg";
import Sun from "../assets/sun.svg";
---

<button type="button" class="theme-toggle" aria-label="Switch to light mode">
  <Moon class="moon" aria-hidden="true" />
  <Sun class="sun" aria-hidden="true" />
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-heading);
    cursor: pointer;
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-heading);
    outline-offset: 2px;
  }

  svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .moon,
  :global(html[data-theme="light"]) .sun {
    display: none;
  }

  :global(html[data-theme="light"]) .moon {
    display: block;
  }
</style>

<script>
  const root = document.documentElement;

  function effectiveTheme() {
    return root.dataset.theme ?? "dark";
  }

  function labelToggles() {
    const next = effectiveTheme() === "dark" ? "light" : "dark";
    document.querySelectorAll(".theme-toggle").forEach((toggle) => {
      toggle.setAttribute("aria-label", `Switch to ${next} mode`);
    });
  }

  document.querySelectorAll(".theme-toggle").forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const theme = effectiveTheme() === "dark" ? "light" : "dark";
      root.dataset.theme = theme;
      labelToggles();
      try {
        localStorage.setItem("theme", theme);
      } catch {}
    });
  });

  labelToggles();
</script>
