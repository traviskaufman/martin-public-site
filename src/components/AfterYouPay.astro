---
import LicenseKeyButton from "./LicenseKeyButton.astro";
import Step from "./Step.astro";
import CodeChip from "./CodeChip.astro";
import CodeBlock from "./CodeBlock.astro";
---

<section aria-labelledby="after-you-pay">
  <h2 id="after-you-pay">What happens after you pay</h2>
  <ol>
    <Step>
      <span>
        You get an email from{" "}
        <a href="mailto:support@trymartin.dev">support@trymartin.dev</a> with
        your license key and setup instructions.
      </span>
    </Step>
    <Step>
      <span>
        Run <CodeChip>/plugin</CodeChip> in Claude Code. Search for{" "}
        <CodeChip>martin</CodeChip>. Install me globally.
      </span>
    </Step>
    <Step>
      <span>
        Run <CodeChip>claude --agent martin</CodeChip>
      </span>
    </Step>
    <Step>
      <span>
        Say: <CodeChip>Introduce Yourself</CodeChip>
      </span>
    </Step>
  </ol>
  <p>
    Want <CodeChip>martin</CodeChip> as a drop-in replacement for{" "}
    <CodeChip>claude</CodeChip>? Add this to your shell profile:
  </p>
  <CodeBlock command="alias martin='claude --agent martin'" />
  <div class="actions">
    <LicenseKeyButton />
  </div>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  ol {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  a {
    color: var(--color-accent-text);
  }

  .actions {
    display: flex;
  }
</style>
