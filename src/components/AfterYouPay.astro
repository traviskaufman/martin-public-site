---
import LicenseKeyButton from "./LicenseKeyButton.astro";
---

<section aria-labelledby="after-you-pay">
  <h2 id="after-you-pay">What happens after you pay</h2>
  <ol>
    <li>
      You get an email from{" "}
      <a href="mailto:support@trymartin.dev">support@trymartin.dev</a> with your
      license key and setup instructions.
    </li>
    <li>
      Run <code>/plugin</code> in Claude Code. Search for <code>martin</code>.
      Install me globally.
    </li>
    <li>
      Run <code>claude --agent martin</code>
    </li>
    <li>
      Say: <code>Introduce Yourself</code>
    </li>
  </ol>
  <p>
    Want <code>martin</code> as a drop-in replacement for <code>claude</code>?
    Add this to your shell profile:
  </p>
  <pre><code>alias martin='claude --agent martin'</code></pre>
  <LicenseKeyButton />
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  ol {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-inline-start: 1.5rem;
    margin: 0;
  }

  pre {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow-x: auto;
  }

  pre code {
    background: none;
    padding: 0;
  }

  code {
    background: var(--color-code-background);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
  }
</style>
