---
import Pause from "../assets/pause.svg";
import Play from "../assets/play.svg";
import Replay from "../assets/replay.svg";
import "../styles/terminal.css";
import { sessionBeats, sessionEnd } from "../session";

const { beats, beat, follows = false } = Astro.props;
const { title, command, section } = beats[beat];
const shown = sessionBeats(beats, follows ? sessionEnd(beats, beat) : beat);
const titleId = `terminal-title-${follows ? "track" : section}`;
---

<div
  class="terminal"
  data-state="static"
  data-beat={beat}
  data-follows={follows || undefined}
  data-inline={follows ? undefined : ""}
  role="region"
  aria-labelledby={titleId}
>
  <div class="chrome">
    <span class="lights" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="terminal-title" id={titleId}>
      {title}
    </span>
    <span class="controls">
      <button type="button" class="speed" aria-label="Playback speed, 2×">
        2×
      </button>
      <button type="button" class="playback" aria-label="Pause">
        <Pause class="pause-icon" aria-hidden="true" />
        <Play class="play-icon" aria-hidden="true" />
      </button>
      <button type="button" class="replay" aria-label="Replay">
        <Replay aria-hidden="true" />
      </button>
    </span>
  </div>
  <div class="pane">
    <p class="command">
      <span class="prompt">&gt;</span>{" "}
      <span class="command-text">{command}</span>
    </p>
    <pre class="transcript">{shown.map((played, index) => [index > 0 && "\n\n", <span class="beat" set:text={played.transcript} />])}</pre>
    <span class="cursor" aria-hidden="true"></span>
  </div>
  <script
    is:inline
    type="application/json"
    class="beats"
    set:html={JSON.stringify(beats)}
  ></script>
</div>

<script>
  import { TerminalStage } from "../scripts/terminal-stage";
  import { BeatFollower } from "../scripts/beat-follower";

  document.documentElement.dataset.js = "ready";

  document.querySelectorAll(".terminal[data-beat]").forEach((terminal) => {
    const beats = JSON.parse(terminal.querySelector(".beats").textContent);
    const first = Number(terminal.dataset.beat);
    const stage = new TerminalStage(terminal, beats);
    const tabs = terminal.closest(".comparison-tabs");
    let playback;
    const follower = terminal.hasAttribute("data-follows")
      ? new BeatFollower(beats, first, (index) => {
          tabs?.setAttribute("data-section", beats[index].section);
          playback?.change(index);
        })
      : null;

    new IntersectionObserver((entries, observer) => {
      if (!entries.some((entry) => entry.isIntersecting)) {
        return;
      }
      observer.disconnect();
      import("../scripts/playback").then(({ startPlayback }) => {
        playback = startPlayback(stage, follower?.current ?? first);
      });
    }).observe(terminal);
  });
</script>
