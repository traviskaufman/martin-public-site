---
const { heading, prompt, vanilla, martin, differentiator } = Astro.props;
const headingId = `comparison-${heading.toLowerCase().replace(/\s+/g, "-")}`;
---

<section aria-labelledby={headingId}>
  <p class="differentiator">{differentiator}</p>
  <h2 id={headingId}>{heading}</h2>
  <blockquote>{prompt}</blockquote>
  <div class="columns">
    <article class="comparison-column">
      <h3>Vanilla Claude Code</h3>
      <div class="transcript">
        <pre>{vanilla}</pre>
      </div>
      <button type="button" class="toggle" aria-expanded="false">
        Show more
      </button>
    </article>
    <article class="comparison-column">
      <h3>Martin</h3>
      <div class="transcript">
        <pre>{martin}</pre>
      </div>
      <button type="button" class="toggle" aria-expanded="false">
        Show more
      </button>
    </article>
  </div>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  blockquote {
    margin: 0;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .differentiator {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 600px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }

  .comparison-column {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
  }

  .comparison-column h3 {
    margin: 0;
    font-size: 1rem;
  }

  .transcript {
    --line-height: 1.5rem;
    position: relative;
    max-height: calc(var(--line-height) * 10);
    overflow: hidden;
  }

  .comparison-column.expanded .transcript {
    max-height: none;
  }

  .transcript::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 2.5rem;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-background)
    );
  }

  .comparison-column.expanded .transcript::after {
    content: none;
  }

  pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: var(--line-height);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .toggle {
    align-self: flex-start;
    padding: 0;
    border: none;
    background: none;
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .toggle[hidden] {
    display: none;
  }

  .toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>

<script>
  document.querySelectorAll(".toggle").forEach((button) => {
    const article = button.closest(".comparison-column");
    const transcript = article?.querySelector(".transcript");
    if (!transcript) return;
    if (transcript.scrollHeight <= transcript.clientHeight) {
      button.hidden = true;
      return;
    }
    button.addEventListener("click", () => {
      const expanded = button.getAttribute("aria-expanded") === "true";
      article?.classList.toggle("expanded", !expanded);
      button.setAttribute("aria-expanded", String(!expanded));
      button.textContent = expanded ? "Show more" : "Show less";
    });
  });
</script>
