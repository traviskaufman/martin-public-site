---
import { sourceUrl } from "../links";
---

<footer>
  <p>Copyright (c) 2026 Singularity Studios, LLC</p>
  <p>
    <a href={sourceUrl} target="_blank" rel="noopener" class="source-link">
      View website source code
    </a>
  </p>
  <p>Made with ❤️ in NYC</p>
</footer>

<style>
  footer {
    max-width: 44rem;
    margin-inline: auto;
    padding-block: 2rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  footer p {
    margin: 0;
  }
</style>
