---
import SourceLink from "./SourceLink.astro";
---

<footer>
  <p>Copyright (c) 2026 Singularity Studios, LLC</p>
  <p>
    <SourceLink label="View website source code" />
  </p>
  <p>Made with ❤️ in NYC</p>
</footer>

<style>
  footer {
    max-width: 78.75rem;
    margin: 4rem auto 0;
    padding: 2rem 5.625rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.5rem;
  }

  @media (max-width: 1199px) {
    footer {
      padding-inline: 2.5rem;
    }
  }

  @media (max-width: 899px) {
    footer {
      flex-direction: column;
      padding-inline: 1.5rem;
    }
  }
</style>
