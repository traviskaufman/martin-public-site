---
import SourceLink from "./SourceLink.astro";
---

<footer>
  <p>Copyright (c) 2026 Singularity Studios, LLC</p>
  <p>
    <SourceLink label="View website source code" />
  </p>
  <p>Made with ❤️ in NYC</p>
</footer>

<style>
  footer {
    max-width: 78.75rem;
    margin-inline: auto;
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.5rem;
  }

  @media (max-width: 899px) {
    footer {
      flex-direction: column;
    }
  }
</style>
