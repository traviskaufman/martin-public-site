---
const { prompt, excerpts, section } = Astro.props;
const transcript = excerpts.map((excerpt) => excerpt.trim()).join("\n\n");
---

<div class="vanilla-panel" data-section={section} hidden={Boolean(section)}>
  <p class="prompt-line">
    <span class="prompt">&gt;</span> <span>{prompt.trim()}</span>
  </p>
  <div class="transcript">
    <pre set:text={transcript}></pre>
    <span class="fade" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
      <i></i>
      <i></i>
    </span>
  </div>
  <button type="button" class="toggle" aria-expanded="false">
    Show more
  </button>
</div>

<style>
  .vanilla-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .vanilla-panel[hidden] {
    display: none;
  }

  .prompt-line {
    display: flex;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.375rem;
    overflow-wrap: anywhere;
  }

  .prompt {
    flex-shrink: 0;
    color: var(--color-accent-text);
  }

  .transcript {
    --line-height: 1.375rem;
    position: relative;
    max-height: calc(var(--line-height) * 10);
    overflow: hidden;
  }

  .vanilla-panel.expanded .transcript {
    max-height: none;
  }

  .fade {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
  }

  .fade i {
    height: 0.75rem;
    background: var(--color-background);
    opacity: 0.15;
  }

  .fade i:nth-child(2) {
    opacity: 0.4;
  }

  .fade i:nth-child(3) {
    opacity: 0.65;
  }

  .fade i:nth-child(4) {
    opacity: 0.85;
  }

  .fade i:nth-child(5) {
    opacity: 1;
  }

  .vanilla-panel.expanded .fade {
    display: none;
  }

  pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: var(--line-height);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .toggle {
    align-self: flex-start;
    padding: 0;
    border: none;
    background: none;
    color: var(--color-accent-text);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    cursor: pointer;
  }

  .toggle[hidden] {
    display: none;
  }

  .toggle:focus-visible {
    outline: 2px solid var(--color-heading);
    outline-offset: 2px;
  }
</style>

<script>
  const CLAMPED_LINES = 10;

  document.querySelectorAll(".vanilla-panel").forEach((panel) => {
    const button = panel.querySelector(".toggle");
    const lines = panel.querySelector("pre").textContent.split("\n").length;
    if (lines <= CLAMPED_LINES) {
      button.hidden = true;
      return;
    }
    button.addEventListener("click", () => {
      const expanded = button.getAttribute("aria-expanded") === "true";
      panel.classList.toggle("expanded", !expanded);
      button.setAttribute("aria-expanded", String(!expanded));
      button.textContent = expanded ? "Show more" : "Show less";
    });
  });
</script>
