---
import Eyebrow from "./Eyebrow.astro";

const { heading, prompt, vanilla, differentiator } = Astro.props;
const headingId = `comparison-${heading.toLowerCase().replace(/\s+/g, "-")}`;
---

<section aria-labelledby={headingId}>
  <Eyebrow label={differentiator} />
  <h2 id={headingId}>{heading}</h2>
  <p class="prompt-line">
    <span class="prompt">&gt;</span> <span>{prompt.trim()}</span>
  </p>
  <article class="comparison-column">
    <h3>
      <span class="dot" aria-hidden="true"></span>Vanilla Claude Code
    </h3>
    <div class="transcript">
      <pre>{vanilla}</pre>
      <span class="fade" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
        <i></i>
        <i></i>
      </span>
    </div>
    <button type="button" class="toggle" aria-expanded="false">
      Show more
    </button>
  </article>
  <p class="martin-below">Martin's reply plays in the terminal below ↓</p>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .prompt-line {
    display: flex;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.375rem;
    overflow-wrap: anywhere;
  }

  .prompt {
    flex-shrink: 0;
    color: var(--color-accent-text);
  }

  .comparison-column {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-text-muted);
  }

  .transcript {
    --line-height: 1.375rem;
    position: relative;
    max-height: calc(var(--line-height) * 10);
    overflow: hidden;
  }

  .comparison-column.expanded .transcript {
    max-height: none;
  }

  .fade {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
  }

  .fade i {
    height: 0.75rem;
    background: var(--color-background);
    opacity: 0.15;
  }

  .fade i:nth-child(2) {
    opacity: 0.4;
  }

  .fade i:nth-child(3) {
    opacity: 0.65;
  }

  .fade i:nth-child(4) {
    opacity: 0.85;
  }

  .fade i:nth-child(5) {
    opacity: 1;
  }

  .comparison-column.expanded .fade {
    display: none;
  }

  pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: var(--line-height);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .toggle {
    align-self: flex-start;
    padding: 0;
    border: none;
    background: none;
    color: var(--color-accent-text);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    cursor: pointer;
  }

  .toggle[hidden] {
    display: none;
  }

  .toggle:focus-visible {
    outline: 2px solid var(--color-heading);
    outline-offset: 2px;
  }

  .martin-below {
    display: none;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.25rem;
  }

  @media (max-width: 899px) {
    .martin-below {
      display: block;
    }
  }
</style>

<script>
  document.querySelectorAll(".toggle").forEach((button) => {
    const article = button.closest(".comparison-column");
    const transcript = article?.querySelector(".transcript");
    if (!transcript) return;
    if (transcript.scrollHeight <= transcript.clientHeight) {
      button.hidden = true;
      return;
    }
    button.addEventListener("click", () => {
      const expanded = button.getAttribute("aria-expanded") === "true";
      article?.classList.toggle("expanded", !expanded);
      button.setAttribute("aria-expanded", String(!expanded));
      button.textContent = expanded ? "Show more" : "Show less";
    });
  });
</script>
