---
import { differentiators } from "../differentiators";
import DifferentiatorPanel from "./DifferentiatorPanel.astro";
---

<section aria-labelledby="differentiators">
  <h2 id="differentiators">What I do that vanilla Claude Code doesn't</h2>
  <ol>
    {differentiators.map(({ title, sentence }, index) => (
      <DifferentiatorPanel
        number={index + 1}
        title={title}
        sentence={sentence}
      />
    ))}
  </ol>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  ol {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 899px) {
    section,
    ol {
      gap: 1.25rem;
    }
  }
</style>
