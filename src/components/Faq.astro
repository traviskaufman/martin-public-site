---
import { faq } from "../faq";
import FaqItem from "./FaqItem.astro";
---

<section aria-labelledby="faq">
  <h2 id="faq">FAQ</h2>
  <dl>
    {faq.map(({ question, answer }) => (
      <FaqItem question={question} answer={answer} />
    ))}
  </dl>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  dl {
    margin: 0;
  }
</style>
