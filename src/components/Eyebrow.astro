---
const { label } = Astro.props;
---

<p class="eyebrow">{label}</p>

<style>
  .eyebrow {
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 500;
    letter-spacing: 0.045rem;
    text-transform: uppercase;
  }
</style>
