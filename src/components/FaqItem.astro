---
const { question, answer } = Astro.props;
---

<div class="faq-item">
  <dt>{question}</dt>
  <dd>{answer}</dd>
</div>

<style>
  .faq-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-border);
  }

  dt {
    color: var(--color-heading);
    font-size: 1.375rem;
    line-height: 1.875rem;
    font-weight: 500;
    letter-spacing: -0.01375rem;
  }

  dd {
    margin: 0;
  }
</style>
