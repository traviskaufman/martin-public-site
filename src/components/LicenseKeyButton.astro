---
import { checkoutUrl } from "../links";
---

<a href={checkoutUrl} class="license-key-button">
  Get your license key for $5
</a>

<script>
  const buttons = document.querySelectorAll(".license-key-button");

  buttons.forEach((button) => {
    button.addEventListener("click", (event) => {
      if (button.getAttribute("aria-disabled") === "true") {
        event.preventDefault();
        return;
      }
      window.posthog?.capture("get_license_key", {}, { send_instantly: true });
      button.textContent = "Opening checkout…";
      button.setAttribute("aria-disabled", "true");
    });
  });
</script>
