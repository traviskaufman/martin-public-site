---
import Site from "../layouts/Site.astro";
import Mark from "../components/Mark.astro";
import CodeChip from "../components/CodeChip.astro";
---

<Site title="Martin — your key is on its way">
  <meta slot="head" name="robots" content="noindex" />
  <div class="confirmation">
    <div class="logo">
      <Mark />
    </div>
    <h1>Your key is on its way</h1>
    <p class="inbox">
      Check your inbox for an email from <strong>support@trymartin.dev</strong>{" "}
      with your key and install instructions.
    </p>
    <div class="next-steps">
      <p>Next steps:</p>
      <ul>
        <li>
          <span>
            Paste the install command from that email into your terminal. I
            install myself into Claude Code.
          </span>
        </li>
        <li>
          <span>
            Run <CodeChip>claude --agent martin</CodeChip>
          </span>
        </li>
        <li>
          <span>
            Say: <CodeChip>Introduce Yourself</CodeChip>
          </span>
        </li>
      </ul>
    </div>
    <p class="support">
      Questions or issues?{" "}
      <a href="mailto:support@trymartin.dev">Contact Support</a> and a human
      will get in touch
    </p>
  </div>
</Site>

<style>
  .confirmation {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 38.75rem;
    margin: 0 auto;
    padding: 6rem 1.5rem 0;
  }

  .logo {
    display: flex;
    font-size: 4rem;
  }

  .inbox {
    font-size: 1.25rem;
    line-height: 2rem;
  }

  .inbox strong {
    color: var(--color-heading);
    font-weight: 600;
  }

  .next-steps {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  li::before {
    content: "";
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    margin-top: 0.375rem;
    border: 1.5px solid var(--color-accent);
    border-radius: var(--radius-sm);
  }

  .support {
    color: var(--color-text-muted);
  }

  .support a {
    color: var(--color-accent-text);
  }

  @media (max-width: 899px) {
    .confirmation {
      gap: 1.5rem;
      padding-top: 4rem;
    }

    .inbox {
      font-size: 1.125rem;
      line-height: 1.75rem;
    }
  }
</style>
