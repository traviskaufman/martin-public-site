---
import { getEntry } from "astro:content";
import Pitch from "../layouts/Pitch.astro";
import Mark from "../components/Mark.astro";
import LicenseKeyButton from "../components/LicenseKeyButton.astro";
import SourceLink from "../components/SourceLink.astro";
import ComparisonTabs from "../components/ComparisonTabs.astro";
import ComparisonVanilla from "../components/ComparisonVanilla.astro";
import Terminal from "../components/Terminal.astro";
import TerminalTrack from "../components/TerminalTrack.astro";
import ClosingPrompt from "../components/ClosingPrompt.astro";
import WhyTravisBuiltMe from "../components/WhyTravisBuiltMe.astro";
import AfterYouPay from "../components/AfterYouPay.astro";
import Faq from "../components/Faq.astro";
import { headline, pitch } from "../pitch";
import { sections } from "../sections";
import { loadBeats } from "../beats";
import { asOwnSession } from "../session";

const beats = await loadBeats();
const ownSession = (section) => [
  asOwnSession(
    beats,
    beats.findIndex((beat) => beat.section === section),
  ),
];

const recordings = new Map(
  await Promise.all(
    sections.map(async (section) => {
      const entries = await Promise.all(
        section.comparisons.map((id) => getEntry("comparisons", id)),
      );
      return [
        section.id,
        entries.filter((entry) => entry).map((entry) => entry.data),
      ];
    }),
  ),
);
const vanillaOf = (id) => ({
  prompt: recordings.get(id)[0]?.prompt ?? "",
  excerpts: recordings.get(id).map((recording) => recording.vanilla),
});
---

<Pitch>
  <div class="tracks">
    <div class="content">
      <section class="hero">
        <div class="logo">
          <Mark />
        </div>
        <h1 id="hero">{headline}</h1>
        <p class="pitch">{pitch}</p>
        <div class="actions">
          <LicenseKeyButton />
          <p class="built">
            I built this site. <SourceLink />
          </p>
        </div>
        <Terminal beats={ownSession("hero")} beat={0} />
      </section>
      {sections.map((section) => (
        <section class="differentiator" aria-labelledby={section.id}>
          <h2 id={section.id}>{section.title}</h2>
          <p class="pitch">{section.sentence}</p>
          {import.meta.env.DEV &&
            recordings.get(section.id).length < section.comparisons.length && (
              <p class="comparison-placeholder">
                I haven't run this one yet — check back soon.
              </p>
            )}
          <ComparisonTabs name={section.id}>
            <Terminal slot="martin" beats={ownSession(section.id)} beat={0} />
            <ComparisonVanilla slot="vanilla" {...vanillaOf(section.id)} />
          </ComparisonTabs>
        </section>
      ))}
      <WhyTravisBuiltMe>
        <Terminal beats={ownSession("why")} beat={0} />
      </WhyTravisBuiltMe>
      <AfterYouPay />
      <Faq />
    </div>
    <TerminalTrack>
      <ComparisonTabs name="track" follows>
        <Terminal slot="martin" beats={beats} beat={0} follows />
        <Fragment slot="vanilla">
          {sections.map((section) => (
            <ComparisonVanilla
              section={section.id}
              {...vanillaOf(section.id)}
            />
          ))}
        </Fragment>
      </ComparisonTabs>
    </TerminalTrack>
  </div>
  <ClosingPrompt />
</Pitch>

<style>
  .tracks {
    display: grid;
    grid-template-columns: minmax(0, 38.75rem) minmax(0, 35rem);
    justify-content: center;
    column-gap: 5rem;
    padding: 6rem 5.625rem 0;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 8rem;
    min-width: 0;
  }

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    min-height: 35rem;
  }

  .hero :global(.terminal) {
    height: auto;
  }

  .logo {
    display: flex;
    font-size: 4rem;
  }

  .pitch {
    font-size: 1.25rem;
    line-height: 2rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .built {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .differentiator {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .differentiator :global(.comparison-tabs) {
    margin-top: 0.75rem;
  }

  .comparison-placeholder {
    padding: 1rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
  }

  @media (max-width: 1199px) {
    .tracks {
      column-gap: 2.5rem;
      padding-inline: 2.5rem;
    }
  }

  @media (max-width: 899px) {
    .tracks {
      grid-template-columns: minmax(0, 1fr);
      padding: 4rem 1.5rem 0;
    }

    .content {
      gap: 6rem;
    }

    .hero {
      gap: 1.5rem;
      min-height: 0;
    }

    .pitch {
      font-size: 1.125rem;
      line-height: 1.75rem;
    }

    .actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
